    {
        def Material "Teal"
        {
            token outputs:surface.connect = </Product/Looks/Teal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.285, 0.34)
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }
    }
}

