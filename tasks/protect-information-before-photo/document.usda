#usda 1.0
(
    defaultPrim = "Document"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Document" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.2
    float physxRigidBody:maxDepenetrationVelocity = 1
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 4
    float3 xformOp:scale = (0.75, 0.75, 0.75)
    uniform token[] xformOpOrder = ["xformOp:scale"]

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0
        float physics:staticFriction = 0.6
    }

    def Cube "Collision0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Document/PhysicsMaterial>
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        uniform token purpose = "guide"
        double size = 1
        float3 xformOp:scale = (0.23, 0.175, 0.008)
        double3 xformOp:translate = (0, 0, 0.004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Collision1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Document/PhysicsMaterial>
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        uniform token purpose = "guide"
        double size = 1
        float3 xformOp:scale = (0.018, 0.065, 0.01)
        double3 xformOp:translate = (0.102, 0, 0.012)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "board"
        {
            token outputs:surface.connect = </Document/Looks/board/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.095, 0.045)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "metal"
        {
            token outputs:surface.connect = </Document/Looks/metal/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.39, 0.42)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "paper"
        {
            token outputs:surface.connect = </Document/Looks/paper/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.94, 0.94, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

