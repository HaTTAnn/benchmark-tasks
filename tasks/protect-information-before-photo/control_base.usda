            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
        def Shader "Texture" {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/send.png@
            token inputs:sourceColorSpace = "sRGB"
            token inputs:wrapS = "clamp"
            token inputs:wrapT = "clamp"
            float2 inputs:st.connect = </Base/LabelMaterial/UV.outputs:result>
            float3 outputs:rgb
        }
    }
    def Mesh "PrintedFace" (prepend apiSchemas = ["MaterialBindingAPI"]) {
        point3f[] points = [(0.015000000000000001, 0.0525, 0.0241), (0.015000000000000001, -0.0525, 0.0241), (0.043000000000000003, -0.0525, 0.0241), (0.043000000000000003, 0.0525, 0.0241)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0,1,2,3]
        texCoord2f[] primvars:st = [(0,0),(1,0),(1,1),(0,1)] (interpolation = "vertex")
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = true
        rel material:binding = </Base/LabelMaterial>
    }
}
