    def Scope "Looks"
    {
        def Material "lid"
        {
            token outputs:surface.connect = </Cap/Looks/lid/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.25, 0.39, 0.29)
                float inputs:roughness = 0.52
                token outputs:surface
            }
        }
        def Material "lid_edge"
        {
            token outputs:surface.connect = </Cap/Looks/lid_edge/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.075, 0.15, 0.1)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
        def Material "lid_highlight"
        {
            token outputs:surface.connect = </Cap/Looks/lid_highlight/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.38, 0.51, 0.39)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

